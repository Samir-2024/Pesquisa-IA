import random

# Inicializa o ambiente
ambiente = [" " for _ in range(10)]

def verificar_ambiente(ambiente):
    print("Verificação do ambiente:")
    print("[", end="")
    for i in range(10):
        if i == 9:
            print(ambiente[i], end=" ")
        else:
            print(ambiente[i], "|", end=" ")
    print("]")

# Gera quantidade de sujeira
qtd_sujeiras = random.randint(1, 10)
print("Quantidade de sujeiras:", qtd_sujeiras)

# Coloca sujeira em posições aleatórias
for _ in range(qtd_sujeiras):
    posicao_sujeira = random.randint(0, 9)  # Posições de 0 a 9
    while ambiente[posicao_sujeira] == "~":  # Garante que não haja duplicação
        posicao_sujeira = random.randint(0, 9)
    ambiente[posicao_sujeira] = "~"

verificar_ambiente(ambiente)

# Coloca o agente em uma posição aleatória
pos_agente = random.randint(0, 9)
ambiente[pos_agente] = "A"
verificar_ambiente(ambiente)

def acoes_agente(ambiente, pos_agente):
    ambiente[pos_agente] = " "  # Limpa a posição atual do agente
    if random.randint(0, 1) == 0:  # Movimenta para a esquerda
        if pos_agente > 0:
            pos_agente -= 1
    else:  # Movimenta para a direita
        if pos_agente < 9:
            pos_agente += 1

    # Verifica se há sujeira na nova posição
    if ambiente[pos_agente] == "~":
        print("O agente limpou a sujeira na posição:", pos_agente)
        ambiente[pos_agente] = " "  # Limpa a sujeira

    ambiente[pos_agente] = "A"  # Atualiza a posição do agente
    return pos_agente

# Executa a simulação até que não haja mais sujeira
while any(pos == "~" for pos in ambiente):
    pos_agente = acoes_agente(ambiente, pos_agente)
    verificar_ambiente(ambiente)

print("Limpeza completa!")
